{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-${GROK_PLUGIN_ROOT:-.}}}/hooks/activation-notice.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "metamorfiles_render_(preview|batch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-${GROK_PLUGIN_ROOT:-.}}}/hooks/after-render.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
