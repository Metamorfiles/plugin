{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('url').pathToFileURL(require('path').join(process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT||process.env.GROK_PLUGIN_ROOT||'.','hooks','activation-notice.mjs')).href)\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "metamorfiles_render_(preview|batch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('url').pathToFileURL(require('path').join(process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT||process.env.GROK_PLUGIN_ROOT||'.','hooks','after-render.mjs')).href)\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
