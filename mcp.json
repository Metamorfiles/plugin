{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "metamorfiles": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "--fetch-retries=0",
        "--fetch-timeout=5000",
        "metamorfiles@latest",
        "mcp",
        "--plugin-root",
        "${CLAUDE_PLUGIN_ROOT}"
      ]
    }
  }
}
